# Copy to .env and edit for your server:   cp .env.example .env
#
# Paths are IDENTITY-MOUNTED: each is mounted at the same location inside the
# container as on the host. So the paths below are exactly what you type in the
# UI — no host/container translation.

# --- Paths -------------------------------------------------------------------

# ALL FOUR PATHS MUST BE SET FOR THIS MACHINE — absolute, no ~ expansion.
# Copying a .env between servers without editing these is the most common
# deployment failure: Docker happily creates the wrong path as root.
#
# Print correct values for the repo and work dir from the repo root with:
#     echo "HOST_REPO_DIR=$(pwd)"; echo "HOST_WORK_DIR=$(pwd)/.mea-watcher"

# Folder that CONTAINS the recording run folders (e.g. <this>/000041).
# Point at the parent, not an individual run. Mounted READ-ONLY.
HOST_INPUT_DIR=/CHANGE/ME/path/to/recordings

# Where the pipeline writes results. Must be writable by HOST_UID:HOST_GID.
# Create it yourself first, or Docker creates it as root.
HOST_OUTPUT_DIR=/CHANGE/ME/path/to/AnalyzedData

# Watcher state + job config + per-run logs. Keep this persistent, otherwise
# the watcher forgets which runs it already processed.
# Create it yourself first:  mkdir -p "$(pwd)/.mea-watcher"
HOST_WORK_DIR=/CHANGE/ME/path/to/MEA-Analysis/.mea-watcher

# The repo checkout (contains run_pipeline_driver.py) — usually `pwd`.
HOST_REPO_DIR=/CHANGE/ME/path/to/MEA-Analysis

# --- Container settings ------------------------------------------------------

# Port on the host to reach the UI: http://localhost:8000
UI_PORT=8000

# Base image the orchestration image builds on. Build it first with:
#   docker build -t mea-spikesorter -f dockers/spikesorter/Dockerfile .
BASE_IMAGE=mea-spikesorter:latest

# Which repo the images clone at build time. Point this at your own fork.
MEA_REPO_URL=https://github.com/hiteshkumar18/MEA-Analysis.git
MEA_REPO_BRANCH=main

# Run as your own user so output files are not owned by root.
# Set these per machine:  id -u   and   id -g
HOST_UID=1000
HOST_GID=1000
